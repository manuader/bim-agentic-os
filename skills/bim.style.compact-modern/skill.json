    {"id": "living-glazing-min", "severity": "warning", "target": {"room": "living*"}, "check": {"op": "ratio_min", "property": "window_area_m2", "over": "area_m2", "parameter": "living_glazing_ratio_min"}, "message": "Living room glazing is below the compact modern style ratio.", "citation": "Style recommendation (compact modern), not normative."},
    {"id": "living-height-min", "severity": "info", "target": {"room": "living*"}, "check": {"op": "min", "property": "clear_height_m", "parameter": "clear_height_min_m"}, "message": "Clear height of living rooms is below the compact modern style height.", "citation": "Style recommendation (compact modern), not normative."},
    {"id": "local-unico-height-min", "severity": "info", "target": {"room": "local unico*"}, "check": {"op": "min", "property": "clear_height_m", "parameter": "clear_height_min_m"}, "message": "Clear height of local unico rooms is below the compact modern style height.", "citation": "Style recommendation (compact modern), not normative."},
    {"id": "monoambiente-height-min", "severity": "info", "target": {"room": "monoambiente*"}, "check": {"op": "min", "property": "clear_height_m", "parameter": "clear_height_min_m"}, "message": "Clear height of monoambiente rooms is below the compact modern style height.", "citation": "Style recommendation (compact modern), not normative."},
    {"id": "pasillo-height-min", "severity": "info", "target": {"room": "pasillo*"}, "check": {"op": "min", "property": "clear_height_m", "parameter": "clear_height_min_m"}, "message": "Clear height of pasillo rooms is below the compact modern style height.", "citation": "Style recommendation (compact modern), not normative."},
    {"id": "studio-height-min", "severity": "info", "target": {"room": "studio*"}, "check": {"op": "min", "property": "clear_height_m", "parameter": "clear_height_min_m"}, "message": "Clear height of studio rooms is below the compact modern style height.", "citation": "Style recommendation (compact modern), not normative."},
    {"id": "wall-thickness-max", "severity": "info", "target": {"element": "wall"}, "check": {"op": "max", "property": "thickness_m", "value": 0.25}, "message": "Wall is thicker than the compact modern style's slim envelope.", "citation": "Style recommendation (compact modern), not normative."}
  ]
}
