{
  "manifest_version": 1,
  "id": "bim.style.compact-modern",
  "version": "1.0.0",
  "kind": "style",
  "description": "Sample compact modern style pack: slim reinforced-concrete envelope with external insulation, generous low-sill glazing, flat green roof, exposed-concrete ceilings and polished-concrete floors. Design defaults and checks are illustrative recommendations only, not a building code; thresholds are never below the CABA code pack minimums they overlap. Excludes bim.style.warm-masonry.",
  "priority": 30,
  "conflicts_with": ["bim.style.warm-masonry"],
  "parameters": [
    {"name": "living_glazing_ratio_min", "type": "number", "default": 0.25, "min": 0.1, "max": 0.6, "description": "Recommended living-room window area over floor area. The lower bound 0.1 is the CABA A/10 illumination minimum, so an override cannot go below code."},
    {"name": "clear_height_min_m", "type": "number", "default": 2.6, "min": 2.6, "max": 3.5, "description": "Recommended clear height of every room the CABA pack sets a clear height for (habitable rooms and corridors); defaults to the same value as room.min_clear_height_m. The lower bound 2.6 is the CABA living-room clear height minimum."}
  ],
  "defaults": {
    "ceiling.finish": "exposed-concrete",
    "door.entrance.width_m": 1.0,
    "door.interior.width_m": 0.8,
    "floor.finish": "polished-concrete",
    "level.height_m": 2.9,
    "roof.type": "flat-green",
    "room.min_clear_height_m": 2.6,
    "wall.exterior.thickness_m": 0.2,
    "wall.exterior.type": "reinforced-concrete-150-etics-50",
    "wall.interior.thickness_m": 0.1,
    "window.head_height_m": 2.5,
    "window.sill_height_m": 0.3,
    "window.wall_ratio": 0.4
  },
  "rules": [
    {"id": "bedroom-height-min", "severity": "info", "target": {"room": "bedroom*"}, "check": {"op": "min", "property": "clear_height_m", "parameter": "clear_height_min_m"}, "message": "Clear height of bedroom rooms is below the compact modern style height.", "citation": "Style recommendation (compact modern), not normative."},
    {"id": "biblioteca-height-min", "severity": "info", "target": {"room": "biblioteca*"}, "check": {"op": "min", "property": "clear_height_m", "parameter": "clear_height_min_m"}, "message": "Clear height of biblioteca rooms is below the compact modern style height.", "citation": "Style recommendation (compact modern), not normative."},
    {"id": "cocina-comedor-guion-height-min", "severity": "info", "target": {"room": "cocina-comedor*"}, "check": {"op": "min", "property": "clear_height_m", "parameter": "clear_height_min_m"}, "message": "Clear height of cocina-comedor rooms is below the compact modern style height.", "citation": "Style recommendation (compact modern), not normative."},
    {"id": "cocina-comedor-height-min", "severity": "info", "target": {"room": "cocina comedor*"}, "check": {"op": "min", "property": "clear_height_m", "parameter": "clear_height_min_m"}, "message": "Clear height of cocina comedor rooms is below the compact modern style height.", "citation": "Style recommendation (compact modern), not normative."},
    {"id": "comedor-height-min", "severity": "info", "target": {"room": "comedor*"}, "check": {"op": "min", "property": "clear_height_m", "parameter": "clear_height_min_m"}, "message": "Clear height of comedor rooms is below the compact modern style height.", "citation": "Style recommendation (compact modern), not normative."},
    {"id": "corredor-height-min", "severity": "info", "target": {"room": "corredor*"}, "check": {"op": "min", "property": "clear_height_m", "parameter": "clear_height_min_m"}, "message": "Clear height of corredor rooms is below the compact modern style height.", "citation": "Style recommendation (compact modern), not normative."},
    {"id": "corridor-height-min", "severity": "info", "target": {"room": "corridor*"}, "check": {"op": "min", "property": "clear_height_m", "parameter": "clear_height_min_m"}, "message": "Clear height of corridor rooms is below the compact modern style height.", "citation": "Style recommendation (compact modern), not normative."},
    {"id": "dining-height-min", "severity": "info", "target": {"room": "dining*"}, "check": {"op": "min", "property": "clear_height_m", "parameter": "clear_height_min_m"}, "message": "Clear height of dining rooms is below the compact modern style height.", "citation": "Style recommendation (compact modern), not normative."},
    {"id": "dormitorio-height-min", "severity": "info", "target": {"room": "dormitorio*"}, "check": {"op": "min", "property": "clear_height_m", "parameter": "clear_height_min_m"}, "message": "Clear height of dormitorio rooms is below the compact modern style height.", "citation": "Style recommendation (compact modern), not normative."},
    {"id": "escritorio-height-min", "severity": "info", "target": {"room": "escritorio*"}, "check": {"op": "min", "property": "clear_height_m", "parameter": "clear_height_min_m"}, "message": "Clear height of escritorio rooms is below the compact modern style height.", "citation": "Style recommendation (compact modern), not normative."},
    {"id": "estar-glazing-min", "severity": "warning", "target": {"room": "estar*"}, "check": {"op": "ratio_min", "property": "window_area_m2", "over": "area_m2", "parameter": "living_glazing_ratio_min"}, "message": "Estar glazing is below the compact modern style ratio.", "citation": "Style recommendation (compact modern), not normative."},
    {"id": "estar-height-min", "severity": "info", "target": {"room": "estar*"}, "check": {"op": "min", "property": "clear_height_m", "parameter": "clear_height_min_m"}, "message": "Clear height of estar rooms is below the compact modern style height.", "citation": "Style recommendation (compact modern), not normative."},
