    {"id": "studio-height-min", "severity": "info", "target": {"room": "studio*"}, "check": {"op": "min", "property": "clear_height_m", "parameter": "clear_height_min_m"}, "message": "Clear height of studio rooms is below the warm masonry style height.", "citation": "Style recommendation (warm masonry), not normative."},
